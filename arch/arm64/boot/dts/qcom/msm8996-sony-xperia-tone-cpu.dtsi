&kryocc {
	/* Sony sys_apcsaux_clk is GPLL0 main output divided by two. */
	clocks = <&xo_board>, <&gcc GPLL0>;
	clock-names = "xo", "aux";
	nvmem-cells = <&sony_cpu_speedbin>;
	nvmem-cell-names = "speedbin";
	qcom,pwrcl-speedbin0-v0 =
