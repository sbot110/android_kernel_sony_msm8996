# Diagnostic fragment for first-boot bring-up on Sony Xperia X Performance (F8131/F8132)
# Usage:
#   ARCH=arm64 scripts/kconfig/merge_config.sh -m arch/arm64/configs/dora_defconfig arch/arm64/configs/dora_diag.config
#   make ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu- olddefconfig
CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE=y
CONFIG_IMG_GZ_DTB=y
CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE_NAMES="msm8996-v3.0-pmi8996-sony-xperia-tone-dora msm8996-pmi8996-sony-xperia-tone-dora msm8996-v3.0-sony-xperia-tone-dora msm8996-sony-xperia-tone-dora"
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_FTRACE=y
CONFIG_PSTORE_RAM=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_SERIAL_MSM=y
CONFIG_SERIAL_MSM_CONSOLE=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_DEBUG_FS=y
CONFIG_REGULATOR_DEBUG=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=30
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=y
CONFIG_LOCKUP_DETECTOR=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=y
CONFIG_WQ_WATCHDOG=y
CONFIG_PANIC_ON_OOPS=y
CONFIG_PANIC_TIMEOUT=5
CONFIG_KALLSYMS=y
# CONFIG_KALLSYMS_ALL is not set
# CONFIG_RANDOMIZE_BASE is not set
# CONFIG_RELOCATABLE is not set
# CONFIG_ARM_QCOM_CPUFREQ_HW is not set
# CONFIG_REGULATOR_CPR3 is not set
# CONFIG_REGULATOR_CPR3_HMSS is not set
# CONFIG_REGULATOR_CPR3_MMSS is not set
